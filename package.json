{
  "name": "avarice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Avarice - a multiplayer 2D economy MMO built with PixiJS, Colyseus and Supabase.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @avarice/server",
    "dev:client": "npm run dev --workspace @avarice/client",
    "build": "npm run build --workspace @avarice/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @avarice/server",
    "db:push": "npm run db:push --workspace @avarice/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
