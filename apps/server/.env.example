# Copy to apps/server/.env for local development.
PORT=2567
CLIENT_ORIGIN=http://localhost:5173

# Supabase project (Project Settings -> API).
# Auth requires these to verify access tokens. Without them the server still
# runs, but logins will be rejected.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string (Project Settings -> Database).
# Used by Prisma for player and economy persistence.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
